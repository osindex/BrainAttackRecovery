FROM golang:1.26-alpine AS build

WORKDIR /src
RUN apk add --no-cache bash ca-certificates git tzdata
ENV GOPROXY=https://goproxy.cn,direct
ENV GOSUMDB=sum.golang.google.cn
COPY . .
RUN bash ./hack/scripts/prepare-packed-assets.sh
RUN mkdir -p apps/lina-core/internal/packed/public && touch apps/lina-core/internal/packed/public/.gitkeep
RUN go build -o /out/lina ./apps/lina-core

FROM alpine:3.20

ENV WORKDIR=/app
ENV TZ=Asia/Shanghai
RUN apk add --no-cache ca-certificates tzdata
WORKDIR $WORKDIR
COPY --from=build /out/lina ./lina
COPY apps/lina-core/manifest/config/config.template.yaml ./config.yaml
COPY hack/docker/local-entrypoint.sh ./local-entrypoint.sh
RUN chmod +x ./local-entrypoint.sh
EXPOSE 8080
ENTRYPOINT ["./local-entrypoint.sh"]
